{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "villas-pastura-booking",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "vars": {
    "APP_ENVIRONMENT": "development",
    "BOOKING_NOTIFICATION_EMAIL": "info@ventustravel.eu"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "villas-pastura-booking",
      "database_id": "b06e5d7a-8f11-4684-97b4-2a1eaba17d8e",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/checkout/*"]
  },
  "secrets": {
    "required": ["NOKUMO_API_KEY", "QUOTE_SIGNING_SECRET", "TURNSTILE_SECRET_KEY"]
  }
}
